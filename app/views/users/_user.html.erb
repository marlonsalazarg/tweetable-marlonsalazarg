<div id="<%= dom_id user %>">
  <div class="card mb-6 overflow-hidden">
    <div class="h-24 bg-gradient-to-r from-primary-200 to-primary-400"></div>
    <div class="flex flex-col items-center px-6 pb-6 text-center">
      <%= image_tag user.avatar, alt: "avatar",
                    class: "-mt-12 size-24 rounded-full object-cover ring-4 ring-white" %>
      <h2 class="mt-3 text-xl font-semibold text-gray-500"><%= user.name %></h2>
      <span class="text-primary-500">@<%= user.username %></span>
      <span class="mt-1 text-sm text-gray-300">Joined on <%= user.created_at.strftime("%B %d, %Y") %></span>

      <% if current_user && current_user.id == user.id %>
        <%= link_to "Edit profile", edit_user_registration_path, class: "btn btn-primary btn-sm mt-4" %>
      <% end %>
    </div>
  </div>
</div>

<div class="flex flex-wrap">
  <input type="radio" class="peer/tweets sr-only" name="profile-tabs" id="tab1" checked>
  <label for="tab1"
         class="cursor-pointer border-b-2 border-transparent px-4 py-3 text-gray-300 transition hover:text-gray-500 peer-checked/tweets:border-primary-600 peer-checked/tweets:font-semibold peer-checked/tweets:text-primary-600 peer-focus-visible/tweets:ring-2 peer-focus-visible/tweets:ring-primary-300">
    Tweets(<%= user.tweets.count %>)
  </label>

  <input type="radio" class="peer/likes sr-only" name="profile-tabs" id="tab2">
  <label for="tab2"
         class="cursor-pointer border-b-2 border-transparent px-4 py-3 text-gray-300 transition hover:text-gray-500 peer-checked/likes:border-primary-600 peer-checked/likes:font-semibold peer-checked/likes:text-primary-600 peer-focus-visible/likes:ring-2 peer-focus-visible/likes:ring-primary-300">
    Likes(<span id="<%= dom_id(user, :likes_count) %>"><%= user.likes.count %></span>)
  </label>

  <div class="order-last hidden w-full border-t border-gray-200 pt-4 peer-checked/tweets:block">
    <div id="tweets" class="space-y-3">
      <% user.tweets.order(created_at: :desc).each do |tweet| %>
        <%= render tweet %>
      <% end %>
    </div>
  </div>

  <div class="order-last hidden w-full border-t border-gray-200 pt-4 peer-checked/likes:block">
    <div id="<%= dom_id(user, :liked_tweets) %>" class="space-y-3">
      <%= render "users/liked_tweets", user: user %>
    </div>
  </div>
</div>
