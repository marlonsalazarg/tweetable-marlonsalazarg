<%# locals: tweet, placeholder: (optional), submit: (optional), replied_to_id: (optional), cancel_path: (optional) %>
<%= form_with(model: tweet, class: "card p-4", data: { controller: "composer" }) do |form| %>
  <% if tweet.errors.any? %>
    <div class="alert-box mb-4">
      <h2 class="font-semibold"><%= pluralize(tweet.errors.count, "error") %> prohibited this tweet from being saved:</h2>
      <ul class="mt-1 list-inside list-disc">
        <% tweet.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex gap-3">
    <%= image_tag current_user.avatar, alt: "", class: "size-11 shrink-0 rounded-full object-cover" %>
    <%= form.text_area :body,
          placeholder: local_assigns[:placeholder] || "Remember to think before you write…",
          maxlength: 140,
          aria: { label: local_assigns[:replied_to_id] ? "Reply" : "Tweet" },
          data: { composer_target: "input", action: "input->composer#update" },
          class: "h-24 w-full resize-none border-0 bg-transparent p-0 pt-2.5 text-gray-400 placeholder:text-gray-300 focus:ring-0" %>
  </div>

  <% if local_assigns[:replied_to_id] %>
    <%= form.hidden_field :replied_to_id, value: replied_to_id %>
  <% end %>

  <div class="mt-3 flex items-center justify-end gap-3 border-t border-gray-200/70 pt-3">
    <span class="mr-auto text-xs tabular-nums text-gray-300">
      <span data-composer-target="count">140</span><span class="sr-only"> characters left</span>
    </span>
    <% if local_assigns[:cancel_path] %>
      <%= link_to "Cancel", cancel_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
    <%= form.submit local_assigns[:submit] || "Tweet", class: "btn btn-primary btn-sm",
                    data: { composer_target: "submit" } %>
  </div>
<% end %>
