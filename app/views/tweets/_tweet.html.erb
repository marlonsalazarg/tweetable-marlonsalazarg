<%# data-tweet, not just the id: the same tweet can be on screen twice (profile Tweets + Likes tabs). %>
<article id="<%= dom_id tweet, local_assigns[:scope] %>" data-tweet="<%= tweet.id %>"
         class="card p-4 transition hover:bg-gray-100/40">
  <div class="flex items-center gap-3">
    <%= image_tag tweet.user.avatar, alt: "avatar", class: "size-11 shrink-0 rounded-full object-cover" %>
    <div class="min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-2">
        <span class="font-semibold text-gray-500"><%= tweet.user.name %></span>
        <span class="text-sm">@<%= link_to tweet.user.username, user_path(tweet.user.id), class: "link" %></span>
      </div>
      <%= link_to "#{time_ago_in_words(tweet.created_at)} ago", tweet,
                  class: "text-sm text-gray-300 hover:underline" %>
    </div>
  </div>

  <p class="mt-3 whitespace-pre-line break-words text-gray-400"><%= tweet.body %></p>

  <div class="mt-4 flex items-center gap-6 text-sm text-gray-300">
    <%= link_to tweet, class: "inline-flex items-center gap-1.5 transition hover:text-primary-500",
                aria: { label: "Replies" } do %>
      <%= render "shared/icons/reply" %>
      <span data-replies-count="<%= tweet.id %>"><%= tweet.replies_count %></span>
    <% end %>

    <%= render "likes/button", tweet: tweet %>

    <% if current_user && current_user.id == tweet.user_id %>
      <div class="ml-auto flex items-center gap-4">
        <%= link_to edit_tweet_path(tweet), class: "transition hover:text-primary-500",
                    aria: { label: "Edit tweet" } do %>
          <%= render "shared/icons/pencil" %>
        <% end %>
        <button type="button" class="cursor-pointer transition hover:text-error-300"
                aria-label="Delete tweet"
                data-action="confirm-dialog#open"
                data-confirm-dialog-url-param="<%= tweet_path(tweet) %>"
                data-confirm-dialog-redirect-param="<%= local_assigns[:redirect_on_delete] ? 1 : 0 %>">
          <%= render "shared/icons/trash" %>
        </button>
      </div>
    <% end %>
  </div>
</article>
