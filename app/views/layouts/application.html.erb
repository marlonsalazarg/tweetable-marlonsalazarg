<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Tweetable" : "Tweetable" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Roboto:wght@500;700&display=swap">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col" data-controller="confirm-dialog">
    <%= render "header/header" %>

    <main class="mx-auto w-full max-w-2xl flex-1 px-4 py-8">
      <%= yield %>
    </main>

    <div id="toasts" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex flex-col items-center gap-2 px-4">
      <%= render "shared/toast", message: notice, type: :notice if notice.present? %>
      <%= render "shared/toast", message: alert, type: :alert if alert.present? %>
    </div>

    <%= render "shared/confirm_dialog" if current_user %>

    <footer class="border-t border-gray-200 py-6 text-sm text-gray-400">
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-1 px-4 sm:flex-row sm:justify-between">
        <p>© 2023 Tweetable</p>
        <p>Built by <span class="font-medium text-gray-500">Marlon Salazar</span></p>
      </div>
    </footer>
  </body>
</html>
