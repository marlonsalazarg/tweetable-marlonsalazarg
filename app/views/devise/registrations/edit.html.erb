<% content_for :title, "Edit profile" %>
<div class="card mx-auto max-w-md p-8">
  <h1 class="mb-6 text-center text-2xl font-semibold text-gray-500">Edit profile</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
                        placeholder: "example@mail.com", class: "input" %>
    </div>

    <div class="mb-4">
      <%= f.label :username, class: "label" %>
      <%= f.text_field :username, autocomplete: "username", placeholder: "example", class: "input" %>
    </div>

    <div class="mb-4">
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, autocomplete: "name", placeholder: "Example Name", class: "input" %>
    </div>

    <div class="mb-4">
      <%= f.label :avatar, class: "label" %>
      <%= image_tag @user.avatar, alt: "Current avatar", class: "mb-3 size-20 rounded-full object-cover" %>
      <%= f.file_field :avatar, class: "input file:mr-3 file:cursor-pointer file:rounded-full file:border-0 file:bg-primary-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-primary-600 hover:file:bg-primary-200" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="mb-4 text-sm">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
    <% end %>

    <div class="mb-4">
      <%= f.label :password, class: "label" %>
      <p class="mb-1 text-xs text-gray-300">Leave blank to keep your current password.</p>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "********", class: "input" %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, class: "label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
                           placeholder: "********", class: "input" %>
    </div>

    <div class="mb-6">
      <%= f.label :current_password, class: "label" %>
      <%= f.password_field :current_password, autocomplete: "current-password",
                           placeholder: "********", class: "input" %>
    </div>

    <%= f.submit "Save changes", class: "btn btn-primary w-full" %>
  <% end %>

  <div class="mt-6 text-center text-sm">
    <%= link_to "Back", :back, class: "link" %>
  </div>
</div>
